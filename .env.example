# Copy this file to .env and fill in your keys. They are used server-side only.
OPENAI_API_KEY=sk-...
# Needed for the default marble bust pipeline. Without it only the LEGO pipeline works.
TRIPO_API_KEY=tsk_...
# Optional overrides:
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_MODEL=gpt-5
# TARGET_HEIGHT_MM=100
