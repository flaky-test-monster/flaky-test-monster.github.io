# Copy this file to .env and fill in your keys. They are used server-side only.
# The local pipeline needs no keys; without this file only it can run.
OPENAI_API_KEY=sk-...
# Needed for the default Tripo3D 3D method. Without it the simple-shapes method (needs
# OPENAI_API_KEY) and the local method still work, for every figure.
TRIPO_API_KEY=tsk_...
# Optional overrides:
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_MODEL=gpt-5
# TARGET_HEIGHT_MM=100
# Local pipeline:
# MFLUX_COMMAND=mflux-generate-kontext
# MFLUX_QUANTIZE=8
# LOCAL_3D_URL=http://127.0.0.1:8080
# LOCAL_3D_RESOLUTION=512
# LOCAL_FAST=1  # faster, rougher statue image for testing (or: scripts/start.sh --fast)
